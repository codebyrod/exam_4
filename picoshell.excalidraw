      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "nbdvFGjOgxEOMmNFrnv8B",
      "type": "text",
      "x": 113.68390192639833,
      "y": 86.21434820399298,
      "width": 287.26353699064487,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6V",
      "roundness": null,
      "seed": 1462142281,
      "version": 241,
      "versionNonce": 224104137,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793993611984,
      "created": 1793993596140,
      "link": null,
      "locked": false,
      "text": "Se não há comandos para executar,\na função retorna 0 (sucesso).",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Se não há comandos para executar, a função retorna 0 (sucesso).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Iv4KRnCWJ4SQcQKxEHa85",
