      "boundElements": null,
      "updated": 1794001679594,
      "created": 1794001439170,
      "link": null,
      "locked": false,
      "text": "#include <unistd.h> --- pipe, fork, close, dup2, execvp, wait \n\n#include <sys/types.h> --- pid_t\n\n#include <sys/wait.h> --- wait, WIFEXITED, WEXISTATUS\n\n#include <stdlib.h> --- exit",
      "fontSize": 18.84600124313694,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#include <unistd.h> --- pipe, fork, close, dup2, execvp, wait \n\n#include <sys/types.h> --- pid_t\n\n#include <sys/wait.h> --- wait, WIFEXITED, WEXISTATUS\n\n#include <stdlib.h> --- exit",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
