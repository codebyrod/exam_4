      "created": 1794001681470,
      "link": null,
      "locked": false,
      "text": "int     prev_fd = -1;   // read end of the previous pipe\nint     pipefd[2];\nint     i = 0;\nint     ret = 0;        // 0 = success, 1 = error\nint     status;",
      "fontSize": 18.84600124313694,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int     prev_fd = -1;   // read end of the previous pipe\nint     pipefd[2];\nint     i = 0;\nint     ret = 0;        // 0 = success, 1 = error\nint     status;",
