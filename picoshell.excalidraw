    {
      "id": "19zIIPp2sjSLKXslN6jKd",
      "type": "text",
      "x": 440.7637108860282,
      "y": 4129.601406033212,
      "width": 130.76821899414062,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
